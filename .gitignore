# ==============================================================================
# MandiMitra Monorepo .gitignore
# ==============================================================================

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert

# Python & virtual environments
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/

# Node.js & Vite
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Local SQLite / Temporary Databases
*.db
*.sqlite
*.sqlite3

# OS metadata
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*~
